# ---------------------------------------------------------------------------
# EverEcho v0.1 — every setting the application reads.
#
# Copy to .env and adjust. The defaults below run the whole product locally
# with no paid credentials: local storage, a local composer, a local scanner,
# a local mail outbox and a local billing state machine.
#
# Production refuses to start on these defaults — see packages/config.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# ---- Branding and legal copy ----------------------------------------------
# "EverEcho" is a working codename pending trademark clearance. Changing these
# renames the product everywhere; nothing hard-codes them.
PRODUCT_NAME=EverEcho
PRODUCT_CODENAME=everecho
SUPPORT_EMAIL=support@everecho.example
DATA_REGION=local
JURISDICTION=IN
CONSENT_COPY_VERSION=consent-copy-2026-01
LEGAL_COPY_VERSION=legal-copy-2026-01-draft
POLICY_ENGINE_VERSION=policy-1

# ---- HTTP ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
# Set true only behind a proxy you control, or client IPs can be spoofed.
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# The browser needs this at build time as well as at run time.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Database --------------------------------------------------------------
DATABASE_URL=postgres://everecho:everecho@localhost:5432/everecho
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---- Cache and queue -------------------------------------------------------
# The durable job queue lives in PostgreSQL so that enqueueing is transactional
# with the domain change that caused it (docs/DECISION_LOG.md, D-004).
# Redis is used only for caching and distributed rate limiting.
CACHE_DRIVER=memory
# REDIS_URL=redis://localhost:6379
QUEUE_DRIVER=postgres
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=500
WORKER_MAX_ATTEMPTS=5

# ---- Object storage --------------------------------------------------------
# local: files on disk, served through short-lived HMAC-signed URLs.
# s3:    any S3-compatible store (MinIO, AWS S3, R2). Required in production.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/storage
STORAGE_SIGNING_SECRET=dev-only-storage-signing-secret-change-me
STORAGE_SIGNED_URL_TTL_SECONDS=300
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=everecho
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# ---- Uploads ---------------------------------------------------------------
UPLOAD_MAX_BYTES=524288000
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/heic,image/tiff,application/pdf,text/plain,audio/mpeg,audio/mp4,audio/wav,audio/webm,audio/ogg,video/mp4,video/webm,video/quicktime

# ---- Authentication --------------------------------------------------------
# AUTH_DRIVER=local is a development-only credential store. Production refuses
# to start with it; configure OIDC instead.
AUTH_DRIVER=local
SESSION_SECRET=dev-only-session-secret-change-me-please
SESSION_TTL_SECONDS=1209600
SESSION_COOKIE_NAME=everecho_session
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com
PASSWORD_MIN_LENGTH=12
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# ---- AI providers ----------------------------------------------------------
# local: a deterministic composer that can only select and quote from the
# archive. It cannot invent a memory, which is why demo mode exercises the real
# provenance and abstention paths rather than a happy path around them.
LLM_DRIVER=local
LLM_MODEL=local-deterministic-v1
# LLM_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MAX_TOKENS=16000

EMBEDDINGS_DRIVER=local
EMBEDDINGS_MODEL=local-hashed-v1
EMBEDDINGS_DIM=256
# EMBEDDINGS_API_KEY=

# The local adapter does not recognise speech. It transcribes text captured
# alongside a recording and reports honestly when there is none.
STT_DRIVER=local
STT_MODEL=local-deterministic-v1
# STT_API_KEY=

# The local adapter reads plain text and PDFs that have a text layer. Scanned
# images need a real OCR provider, and it says so rather than returning nothing.
OCR_DRIVER=local
OCR_MODEL=local-deterministic-v1
# OCR_API_KEY=

# Not negotiable: no provider may train on private memory data.
AI_PROVIDER_NO_TRAINING=true
AI_PROVIDER_RETENTION_DAYS=0

# ---- Real-time providers ----------------------------------------------------
#
# Separate from the drivers above, because sending a finished transcript to a
# provider and sending live microphone audio to one are different decisions.
# All three default to local, so a deployment that configures nothing sends
# nothing anywhere. The local implementations are complete: the conversation
# runs end to end with no credentials, and the local recogniser says it cannot
# transcribe rather than inventing words.
#
# None of the hosted adapters below has been run against its real provider.
# See docs/REALTIME_PRODUCTION_READINESS.md before enabling one.
REALTIME_STT_DRIVER=local
REALTIME_LLM_DRIVER=local
REALTIME_TTS_DRIVER=local
# DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_BASE_URL=wss://api.deepgram.com

# An EverEcho voice identifier, never a provider's. The adapter maps it to a
# generic stock voice from a table fixed in code. There is no setting anywhere
# that can name a voice belonging to a person, and there never will be.
REALTIME_VOICE_ID=assistant-neutral-en-v1

# ---- Email -----------------------------------------------------------------
# local writes readable messages to EMAIL_OUTBOX_DIR instead of sending them.
EMAIL_DRIVER=local
EMAIL_FROM=no-reply@everecho.example
EMAIL_OUTBOX_DIR=./var/outbox
# SMTP_URL=smtp://user:pass@localhost:1025

# ---- Billing ---------------------------------------------------------------
# local is a real state machine with no money in it: checkout returns a URL into
# this app, and webhooks are HMAC-signed exactly as a provider's would be.
BILLING_DRIVER=local
BILLING_CURRENCY=INR
BILLING_RESERVATION_AMOUNT_MINOR=199900
BILLING_WEBHOOK_SECRET=dev-only-billing-webhook-secret
# BILLING_API_KEY=sk_test_...

# ---- Malware scanning ------------------------------------------------------
# local is not an antivirus and does not claim to be: it recognises the EICAR
# test string and catches files whose bytes do not match their declared type.
SCAN_DRIVER=local
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# ---- Analytics and observability -------------------------------------------
# Identifiers are salted hashes and property values are restricted by schema to
# numbers, booleans and a three-value bucket. Content cannot be logged.
ANALYTICS_DRIVER=local
ERROR_MONITOR_DRIVER=local
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=everecho

# ---- Feature flags ---------------------------------------------------------
# Prohibited in v0.1. loadConfig refuses to start if either is true.
FEATURE_PERFORM_MODE=false
FEATURE_SUCCESSION_EXECUTION=false
# P4 model inference in customer-visible answers. Off by default.
FEATURE_P4_INFERENCE_IN_ANSWERS=false
FEATURE_DEMO_MODE=true
FEATURE_BILLING=true
FEATURE_ADMIN_TOOLS=true

# ---- Safety ----------------------------------------------------------------
SAFETY_EMERGENCY_INFO_REGION=IN
SAFETY_ESCALATION_EMAIL=safety@everecho.example
